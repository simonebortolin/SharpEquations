<Project Sdk="Microsoft.NET.Sdk">

  <!-- The tests of the controls of SharpEquations.WinForms, in a form of their own thread (Ui): they build on every
       system (EnableWindowsTargeting) and run on Windows only. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>SharpEquations.WinForms.Tests</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SharpEquations.WinForms\SharpEquations.WinForms.csproj" />
  </ItemGroup>

</Project>
