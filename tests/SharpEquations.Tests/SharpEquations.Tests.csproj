<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 (Linux, macOS) and net481 (Windows) test the netstandard2.0 build of the library -->
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <TargetFrameworks Condition=" $([MSBuild]::IsOSPlatform('Windows')) ">net10.0;net481</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>SharpEquations.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFrameworkIdentifier)' == '.NETFramework' ">
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SharpEquations\SharpEquations.csproj" Condition=" '$(TargetFramework)' == 'net10.0' " />
    <ProjectReference Include="..\..\src\SharpEquations\SharpEquations.csproj" Condition=" '$(TargetFramework)' != 'net10.0' "
                      SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>

</Project>
