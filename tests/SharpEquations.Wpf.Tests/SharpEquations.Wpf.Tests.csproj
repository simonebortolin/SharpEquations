<Project Sdk="Microsoft.NET.Sdk">

  <!-- The tests of the controls of SharpEquations.Wpf, in a window of their own thread (Ui): they build on every
       system (EnableWindowsTargeting) and run on Windows only. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>SharpEquations.Wpf.Tests</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SharpEquations.Wpf\SharpEquations.Wpf.csproj" />
  </ItemGroup>

</Project>
