<Project Sdk="Microsoft.NET.Sdk">

  <!-- A second demo, a set of math tools around the editor: the views (MathToolsView, shared with the WebAssembly
       page) and the desktop window. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <RootNamespace>SharpEquations.Avalonia.MathTools</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SharpEquations.Avalonia\SharpEquations.Avalonia.csproj" />
    <ProjectReference Include="..\SharpEquations.MathTools.Core\SharpEquations.MathTools.Core.csproj" />
    <ProjectReference Include="..\SharpEquations.MathTools.Graphing\SharpEquations.MathTools.Graphing.csproj" />
  </ItemGroup>

</Project>
