<Project Sdk="Microsoft.NET.Sdk">

  <!-- The graphs of the math tools without a user interface: the region of the plane shown, and its axes. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <!-- trimmed and compiled ahead of time on WebAssembly: the analyzers tell at build time what would break there -->
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>SharpEquations.MathTools.Graphing</RootNamespace>
  </PropertyGroup>

</Project>
