<Project Sdk="Microsoft.NET.Sdk">

  <!-- An ICasEngine over the engine of Microsoft Mathematics (mathenginen.dll), to compare its results with those of
       AngouriMath. Windows only, and only where Microsoft Mathematics is installed: the library is loaded from the
       installation (or from MATHENGINEN_PATH) and is never part of this repository. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <RootNamespace>SharpEquations.MathTools.MathEngine</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- the products of sines and cosines written as sines and cosines of multiple angles, which the engine does not do -->
    <PackageReference Include="MathNet.Symbolics" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpEquations.MathTools.Core\SharpEquations.MathTools.Core.csproj" />
  </ItemGroup>

</Project>
