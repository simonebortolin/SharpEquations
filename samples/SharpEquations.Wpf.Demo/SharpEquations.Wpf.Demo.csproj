<Project Sdk="Microsoft.NET.Sdk">

  <!-- A window with the editor of SharpEquations.Wpf: it builds on every system, and runs on Windows. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SharpEquations.Wpf\SharpEquations.Wpf.csproj" />
  </ItemGroup>

</Project>
