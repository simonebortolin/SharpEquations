<Project Sdk="Microsoft.NET.Sdk">

  <!-- The math tools without a user interface: the computer algebra (ICasEngine, with AngouriMath, which reads what
       an equation means through MathReader), the formulas, the units, the triangles and the services the app asks the
       platform for. It builds for the desktop and for WebAssembly alike. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <RootNamespace>SharpEquations.MathTools</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngouriMath" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SharpEquations\SharpEquations.csproj" />
  </ItemGroup>

</Project>
