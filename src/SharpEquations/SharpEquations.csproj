<Project Sdk="Microsoft.NET.Sdk">

  <!-- Equation converters with MathML as the common representation. It depends on no package but System.Memory on
       .NET Standard 2.0, for the generated UnicodeMath parser. -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <AssemblyName>SharpEquations</AssemblyName>
    <RootNamespace>SharpEquations</RootNamespace>
    <PackageId>SharpEquations</PackageId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- the UnicodeMath grammar (*.parlot.cs) is compiled by Parlot.SourceGenerator; relative #line paths keep
         the build reproducible -->
    <ParlotLineDirectives>relative</ParlotLineDirectives>
    <!-- trimming and Native AOT: no reflection and no code generated at run time (the stylesheets are compiled to C#
         at build time); the analyzers keep it so -->
    <IsAotCompatible Condition=" $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0')) ">true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpEquations.Tests" />
    <InternalsVisibleTo Include="SharpEquations.Benchmarks" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" Visible="false" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    <!-- build time only: the public API is listed in PublicAPI.Shipped.txt and PublicAPI.Unshipped.txt, and a change
         to it fails the build until it is listed there -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <!-- build time only: the generated parser does not reference Parlot -->
    <PackageReference Include="Parlot.SourceGenerator" PrivateAssets="all" />
  </ItemGroup>

  <!-- the generated parser uses spans: on .NET Standard 2.0 they come from System.Memory, which must flow to the
       consumers of the package -->
  <ItemGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' ">
    <PackageReference Include="System.Memory" />
  </ItemGroup>

  <!-- build time only: the stylesheets compiled to C# (Internal/Xslt), which runs without generating code at run time -->
  <ItemGroup>
    <AdditionalFiles Include="Resources\*.xsl" />
    <ProjectReference Include="..\SharpEquations.XsltGenerator\SharpEquations.XsltGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <!-- build time only: [GeneratedRegex], which .NET Standard 2.0 lacks, as a Regex built once (the regular expression
       generator of .NET does it on net10.0) -->
  <ItemGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' ">
    <ProjectReference Include="..\SharpEquations.RegexPolyfill\SharpEquations.RegexPolyfill.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

</Project>
