<Project Sdk="Microsoft.NET.Sdk">

  <!-- Equation converters with MathML as the common representation (OMML, MTEF). It depends on no
       package, so that it can be used on its own. -->
  <PropertyGroup>
    <TargetFrameworks>net472;netstandard2.0;netstandard2.1;net8.0;net10.0</TargetFrameworks>
    <AssemblyName>SharpEquations</AssemblyName>
    <RootNamespace>SharpEquations</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\*.xsl" LogicalName="SharpEquations.Resources.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
