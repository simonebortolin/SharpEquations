<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build time only: [GeneratedRegex] for the netstandard2.0 build of SharpEquations, which has no regular
       expression generator. It is referenced as an analyzer and is neither shipped nor a dependency of the package. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <!-- the rules of the analyzer (SYSLIB1045 where .NET does not report it) -->
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

</Project>
